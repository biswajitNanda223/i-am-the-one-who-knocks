{
  "name": "@knocks/study-api",
  "version": "1.0.0",
  "private": true,
  "description": "TypeScript API for the reverse-proxy networking lab",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build:test && node --test dist-test/test/**/*.test.js",
    "build:test": "tsc -p tsconfig.test.json",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "sbom": "npm sbom --sbom-format cyclonedx > sbom.cdx.json",
    "start": "node dist/server.js"
  },
  "devDependencies": {
    "@types/node": "26.6.1",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
